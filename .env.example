# Copy to .env for local development. Never commit the real .env.
# In deployed environments these come from the ECS task definition; secrets
# come from Secrets Manager / SSM via the task definition's `secrets:` block.

FLASK_ENV=development
FLASK_DEBUG=True
# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(32))"
FLASK_SECRET_KEY=replace-me-with-a-locally-generated-value

AMPLIFY_USER_POOL_ID=
AMPLIFY_USER_POOL_CLIENT_ID=
AWS_REGION=eu-central-1

GREMLIN_ENDPOINT=localhost
GREMLIN_PORT=8182
GREMLIN_SSL=false

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

LOG_LEVEL=INFO
